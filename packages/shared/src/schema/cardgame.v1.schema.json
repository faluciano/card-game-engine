{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://card-engine.dev/schemas/cardgame.v1.json",
  "title": "Card Game Ruleset",
  "description": "Schema for .cardgame.json files defining a card game's rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "players": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "slug",
        "version",
        "author",
        "players"
      ]
    },
    "deck": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "enum": [
                "standard_52",
                "standard_54"
              ]
            },
            "copies": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cardValues": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "dual"
                          },
                          "low": {
                            "type": "number"
                          },
                          "high": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "kind",
                          "low",
                          "high"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "preset",
            "copies",
            "cardValues"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "const": "custom"
            },
            "cards": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "suit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rank": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "suit",
                  "rank"
                ]
              }
            },
            "copies": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cardValues": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "fixed"
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "dual"
                          },
                          "low": {
                            "type": "number"
                          },
                          "high": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "kind",
                          "low",
                          "high"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "preset",
            "cards",
            "copies",
            "cardValues"
          ]
        }
      ]
    },
    "zones": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "public"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "owner_only"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "hidden"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "partial"
                  },
                  "rule": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "rule"
                ]
              }
            ]
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxCards": {
            "type": "integer",
            "minimum": 1
          },
          "phaseOverrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "visibility": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "public"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "owner_only"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "hidden"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "partial"
                        },
                        "rule": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "rule"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "phase",
                "visibility"
              ]
            }
          }
        },
        "required": [
          "name",
          "visibility",
          "owners"
        ]
      }
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "isHuman": {
            "type": "boolean"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "const": "per_player"
              }
            ]
          }
        },
        "required": [
          "name",
          "isHuman",
          "count"
        ]
      }
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "automatic",
              "turn_based",
              "all_players"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string"
                },
                "effect": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "label",
                "effect"
              ]
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "to",
                "when"
              ]
            }
          },
          "onEnter": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onStep": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onExit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "turnOrder": {
            "type": "string",
            "enum": [
              "clockwise",
              "counterclockwise",
              "fixed"
            ]
          },
          "autoEndTurnCondition": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "actions",
          "transitions"
        ]
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "winCondition": {
          "type": "string",
          "minLength": 1
        },
        "bustCondition": {
          "type": "string"
        },
        "tieCondition": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "winCondition"
      ]
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "initial": {
                "type": "number"
              },
              "public": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "initial"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "initial": {
                "type": "string"
              },
              "public": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "initial"
            ]
          }
        ]
      }
    },
    "globalTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "to",
          "when"
        ]
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "semicircle",
            "circle",
            "grid",
            "linear"
          ]
        },
        "tableColor": {
          "type": "string",
          "enum": [
            "felt_green",
            "wood",
            "dark",
            "custom"
          ]
        },
        "customColor": {
          "type": "string"
        }
      },
      "required": [
        "layout",
        "tableColor"
      ]
    }
  },
  "required": [
    "meta",
    "deck",
    "zones",
    "roles",
    "phases",
    "scoring",
    "ui"
  ]
}
